# Copy to .env and fill in. .env is gitignored — your keys never get committed.

# --- LLM (required for `generate`, `simulate`, `run`) ---
ANTHROPIC_API_KEY=
# Optional: override the model (default: claude-sonnet-4-6)
HOOKFORGE_MODEL=claude-sonnet-4-6

# --- X / Twitter (required for `publish --platform x`) ---
# From developer.x.com → your app → Keys and tokens. App must have Read+Write.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- Instagram / Meta (required for `publish --platform instagram`) ---
# Needs an IG Business/Creator account linked to a Facebook Page + a Meta app
# with instagram_content_publish. IG_USER_ID is your IG Business account id.
IG_ACCESS_TOKEN=
IG_USER_ID=
